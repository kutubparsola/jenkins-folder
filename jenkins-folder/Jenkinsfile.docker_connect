pipeline{
    agent{
        docker "alpine" //Once Jenkins finds an available worker node with the "linux" label, it uses that node's Docker daemon to spin up the alpine container. From that point on, all the stages and steps defined in the pipeline execute inside that isolated Alpine Docker container, rather than directly on the host operating system of the Linux node.
        label "linux"
    }
    stages{
        stage(build){
            steps{
                sh 'hostname'
            }
        }
    }
}
//in the machine/node where you are running make sure you download "docker.io" there
// download the docker plugins(docker pipeline)
